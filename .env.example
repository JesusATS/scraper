# Plantilla de variables de entorno para los scrapers IMSS.
# Copia este archivo a .env y rellena con tus datos.
# .env está en .gitignore — NUNCA committearlo.
#
#   cp .env.example .env

# ── Credenciales IMSS ──────────────────────────────────────────────────────
# Ruta absoluta al archivo .cer (certificado FIEL).
IMSS_RUTA_CER=/ruta/a/tu/certificado.cer

# Ruta absoluta al archivo .key (llave privada FIEL).
IMSS_RUTA_KEY=/ruta/a/tu/llave.key

# RFC con homoclave del firmante (login del portal).
IMSS_USUARIO=TU_RFC_AQUI

# Contraseña del portal IDSE / Escritorio Virtual.
IMSS_CONTRASENA=tu_contrasena_aqui

# Opcional: RFC adicional. Solo necesario para Escritorio Virtual cuando el
# RFC del representante (USUARIO) difiere del RFC consultado. Default: igual
# a IMSS_USUARIO.
# IMSS_RFC=
